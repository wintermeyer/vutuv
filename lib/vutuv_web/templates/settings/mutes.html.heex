<.settings_shell user={@user} active={:mutes} title={gettext("Muted accounts")}>
  <.card>
    <.section_title>{gettext("Muted accounts")}</.section_title>
    <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">
      {gettext(
        "Accounts whose posts stay out of your feed, and accounts whose reposts do. This list is yours alone: it is never shared and nobody is told they are on it."
      )}
    </p>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
      {gettext(
        "You mute an account where you meet it: the ⋯ menu on any of its posts, or its own page. Muting works whether or not you follow them."
      )}
    </p>

    <ul id="account-mute-list" class="mt-6 divide-y divide-slate-100 dark:divide-slate-800">
      <li
        :for={mute <- @mutes}
        id={"account-mute-#{mute.target.id}"}
        class="flex flex-col gap-3 py-4 first:pt-0 last:pb-0 sm:flex-row sm:items-center sm:justify-between"
        data-account-mute={Mutes.kind(mute.target)}
        data-mute-scope={mute.scope}
      >
        <div class="min-w-0">
          <.link
            navigate={Mutes.path(mute.target)}
            class="text-sm font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300"
          >
            {Mutes.display_name(mute.target)}
          </.link>
          <p class="truncate text-xs text-slate-600 dark:text-slate-400">
            {Mutes.handle(mute.target)}
          </p>
          <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
            {mute_scope_label(mute.scope)}
            <span :if={mute.source == :follow}>
              · {gettext("muted on the follow itself")}
            </span>
          </p>
        </div>

        <div class="flex shrink-0 flex-wrap items-center gap-2">
          <%!-- The other scope, as one control: a member who muted a whole
          account because its reposts annoyed them wants the account back
          without hunting for one of its posts, and the other way round. --%>
          <.button
            :if={mute.scope == :reposts}
            href={
              ~p"/settings/mutes?#{[kind: Mutes.kind(mute.target), id: mute.target.id, scope: "all"]}"
            }
            method="post"
            variant="secondary"
          >
            {gettext("Mute everything")}
          </.button>
          <.button
            :if={mute.scope == :all}
            href={
              ~p"/settings/mutes?#{[kind: Mutes.kind(mute.target), id: mute.target.id, scope: "reposts"]}"
            }
            method="post"
            variant="secondary"
          >
            {gettext("Only hide reposts")}
          </.button>
          <.button
            href={~p"/settings/mutes?#{[kind: Mutes.kind(mute.target), id: mute.target.id]}"}
            method="delete"
            variant="danger-ghost"
          >
            {gettext("Unmute")}
          </.button>
        </div>
      </li>
    </ul>

    <p :if={@mutes == []} class="mt-6 text-sm text-slate-600 dark:text-slate-400">
      {gettext("You have not muted anyone yet.")}
    </p>

    <p class="mt-6 border-t border-slate-100 pt-4 text-sm text-slate-600 dark:border-slate-800 dark:text-slate-400">
      {gettext("Looking for words, phrases or tags instead?")}
      <.link
        navigate={~p"/settings/filters"}
        class="font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300"
      >
        {gettext("Muted words & tags")}
      </.link>
    </p>
  </.card>
</.settings_shell>
