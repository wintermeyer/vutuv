<%!-- Notification settings. Three cards: which emails vutuv may send (one positive
flag per type, all default off except messages, checked submits "true"), the one
in-app notification kind a member can switch off (CV updates from people they
follow, issue #980), and an honest read-only explainer of the always-on rest.
Each helper line is forced font-normal because the surrounding <label> defaults
to bold (components.css), which would otherwise render the hint heavier than its
heading. --%>
<.settings_shell user={@user} active={:notifications} title={gettext("Notifications")}>

  <div class="space-y-6">
    <.card>
      <.section_title>{gettext("Email notifications")}</.section_title>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
        {gettext("Pick which emails vutuv may send you. Each email has a one-click unsubscribe.")}
      </p>

      <.form
        :let={f}
        for={@changeset}
        action={~p"/settings/notifications"}
        class="mt-5 space-y-5"
      >
        <.form_error changeset={@changeset} />

        <div class="space-y-4">
          <.setting_toggle label={gettext("Unread messages")}>
            <:checkbox><%= checkbox f, :notification_emails?, class: checkbox_class() %></:checkbox>
            {gettext("When someone messages you and you have not read it yet.")}
          </.setting_toggle>

          <%!-- How the unread-message email behaves. Indented under the toggle
                because it only matters while that is on (said plainly in the
                hint), and kept simple: two selects a member reads at a glance. --%>
          <div class="ml-7 grid gap-4 sm:grid-cols-2">
            <div>
              <%= label f, :dm_email_each_message?, gettext("How often"), class: "mb-1 block text-sm font-medium text-slate-900 dark:text-white" %>
              <%= select f, :dm_email_each_message?, dm_frequency_options(), class: input_class() %>
            </div>
            <div>
              <%= label f, :dm_email_delay_minutes, gettext("Send the email"), class: "mb-1 block text-sm font-medium text-slate-900 dark:text-white" %>
              <%= select f, :dm_email_delay_minutes, dm_delay_options(), class: input_class() %>
            </div>
          </div>
          <p class="ml-7 text-sm font-normal text-slate-600 dark:text-slate-400">
            {gettext(
              "We wait a little before emailing, so you can read the message yourself first. These two settings apply only while unread-message emails are on."
            )}
          </p>
        </div>

        <.setting_toggle label={gettext("Endorsements")}>
          <:checkbox><%= checkbox f, :email_on_endorsement?, class: checkbox_class() %></:checkbox>
          {gettext("When someone endorses you for one of your tags.")}
        </.setting_toggle>

        <.setting_toggle label={gettext("New followers")}>
          <:checkbox><%= checkbox f, :email_on_follower?, class: checkbox_class() %></:checkbox>
          {gettext("When someone starts following you.")}
        </.setting_toggle>

        <%!-- On by default, unlike its neighbours: this one answers a question
              the member asked and then waited minutes for, and it is what
              makes "you can close this page" an honest thing to tell them. --%>
        <.setting_toggle label={gettext("Employment reference reviews")}>
          <:checkbox>
            <%= checkbox f, :email_on_reference_check?, class: checkbox_class() %>
          </:checkbox>
          {gettext(
            "When the review of one of your employment references is finished. It takes minutes, so you can close the page and wait for the email."
          )}
        </.setting_toggle>

        <.setting_toggle label={gettext("Newsletter")}>
          <:checkbox><%= checkbox f, :newsletter_emails?, class: checkbox_class() %></:checkbox>
          {gettext("Occasional vutuv news and announcements.")}
        </.setting_toggle>

        <div class="pt-1">
          <.button type="submit">{gettext("Save")}</.button>
        </div>
      </.form>
    </.card>

    <%!-- CV updates (issue #980): the one in-app kind a member can switch off,
          because it is the only one triggered by somebody else's housekeeping
          rather than by something they did to you. Never emailed. --%>
    <.toggle_form_card
      changeset={@changeset}
      field={:cv_update_notifications?}
      form_id="cv-updates-form"
      action={~p"/settings/notifications"}
      title={gettext("CV updates")}
      intro={
        gettext(
          "When someone you follow adds a new entry to their CV, they can let their followers know. It shows up under the bell, never by email."
        )
      }
      label={gettext("Tell me about new CV entries of people I follow")}
      hint={gettext("When off, you never see this kind of notification, whoever sends it.")}
    />

    <%!-- Thread replies (issue #1025): the second in-app kind a member can
          switch off. It is what lets a live discussion reach everyone who wrote
          in the thread, but a busy thread gets loud. Direct answers to your own
          post (the "reply" kind) are unaffected and stay on. Never emailed. --%>
    <.toggle_form_card
      changeset={@changeset}
      field={:thread_notifications?}
      form_id="thread-notifications-form"
      action={~p"/settings/notifications"}
      title={gettext("Thread replies")}
      intro={
        gettext(
          "When someone replies anywhere in a thread you have written in, you hear about it under the bell, so a discussion reaches everyone who took part. Never by email."
        )
      }
      label={gettext("Tell me about new replies in threads I take part in")}
      hint={
        gettext(
          "When off, you only hear about direct answers to your own posts, never other replies in the thread."
        )
      }
    />

    <%!-- Browser notifications (issue #1249): the one switch in this app that
          is OFF by default, because it is the only one that puts something over
          whatever the member is doing in another window. Switching it on is also
          what makes a browser ask for permission, so nobody who left it alone is
          ever prompted.

          Two states have to be told apart here and only the browser knows the
          second: the account says "yes, I want these", each browser says whether
          it will actually show one. So the card carries a status line per
          permission state, all four shipped and switched off by the plain
          `hidden` attribute (never a display utility - the issue #880 trap),
          with app.js revealing the one that applies. The form also asks for
          permission the moment the box is ticked, because that click is a user
          gesture and Firefox and Safari refuse the request without one. --%>
    <.toggle_form_card
      changeset={@changeset}
      field={:browser_notifications?}
      form_id="browser-notifications-form"
      action={~p"/settings/notifications"}
      title={gettext("Browser notifications")}
      intro={
        gettext(
          "When something arrives while you have vutuv open in a tab you are not looking at, your browser can show it as a notification. Off unless you switch it on."
        )
      }
      label={gettext("Show me browser notifications")}
      hint={
        gettext(
          "Only while vutuv is open somewhere and you are looking at something else. Every browser you use asks you once."
        )
      }
    >
      <:footnote>
        <div data-browser-notifications class="ml-7 text-sm text-slate-600 dark:text-slate-400">
          <p hidden data-notify-state="default">
            {gettext("This browser has not been asked yet.")}
            <button
              type="button"
              data-notify-allow
              class="font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300"
            >
              {gettext("Ask now")}
            </button>
          </p>
          <%!-- Only the granted state offers the test: it is the one state
                where a popup can appear at all, and a button that cannot work
                is worse than no button. It travels the whole path a real
                notification takes (shell socket, server, hook), so it answers
                what the sentence beside it cannot - permission is only the
                last link. The verdict line ships empty and hidden; app.js
                fills it from the two data- strings, because the server is the
                only side that knows the reader's language. --%>
          <p hidden data-notify-state="granted">
            {gettext("This browser will show them.")}
            <button
              type="button"
              data-notify-test
              class="font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300"
            >
              {gettext("Send a test notification")}
            </button>
          </p>
          <p
            hidden
            data-notify-test-result
            data-sent={gettext("Sent. If nothing appeared, your system is holding it back. Check Do Not Disturb and your notification settings.")}
            data-silent={gettext("No answer. Please reload the page and try again.")}
            class="mt-1"
            role="status"
          >
          </p>
          <p hidden data-notify-state="denied">
            {gettext(
              "This browser is blocking notifications for vutuv. Allow them for this site in your browser settings; the switch above stays on and every other browser you use is unaffected."
            )}
          </p>
          <p hidden data-notify-state="unsupported">
            {gettext("This browser cannot show notifications. Your other browsers are unaffected.")}
          </p>

          <%!-- "Also when vutuv is closed" (issue #1729): the same account
                switch above, carried by a service worker so a notification
                survives the tab. It is **per device** and not part of the form,
                because a push subscription belongs to one browser and not to
                the account - which is why it is written straight from
                app.js and why the box starts disabled, until the browser has
                said whether it holds one.

                On an iPhone this is the only path to a notification at all:
                the Push API exists there only for a Home Screen web app, and
                the switch above can do nothing until the site is installed.

                Hidden entirely where the operator switched push off
                (WEB_PUSH_ENABLED=false, the intranet case) - a switch that
                cannot work is worse than no switch. --%>
          <div :if={@push_enabled?} class="mt-3 border-t border-slate-200 pt-3 dark:border-slate-700">
            <%!-- It starts `disabled` because only the browser knows whether it
                  already holds a subscription; app.js answers that and enables
                  it. A box that could be ticked before anything has read its
                  real state would be a switch whose position is a guess. --%>
            <.setting_toggle label={gettext("Also notify me on this device when vutuv is closed")}>
              <:checkbox>
                <input type="checkbox" data-push-device disabled class={checkbox_class()} />
              </:checkbox>
              {gettext(
                "This one browser only, so say it again on every phone and computer you want it on. On an iPhone, add vutuv to your Home Screen first - Safari can only do this for an installed app."
              )}
            </.setting_toggle>

            <%!-- What a member cannot otherwise find out: which of their
                  browsers is still on the list. The row action forgets one from
                  here, which is the only way to end a subscription on a device
                  you no longer have — its own link rather than
                  `<.row_actions>`, whose label is the word "Delete": nothing is
                  deleted here that the device cannot register again in one tap,
                  and beside a device name that word reads as a threat to the
                  device. --%>
            <div :if={@push_devices != []} class="ml-7 mt-3">
              <p class="font-medium text-slate-900 dark:text-white">
                {gettext("Devices being notified")}
              </p>
              <ul class="mt-1">
                <li :for={device <- @push_devices} class="flex items-center gap-4">
                  <span>{device.device || gettext("Unknown device")}</span>
                  <.link
                    href={~p"/settings/push_devices/#{device.id}"}
                    method="delete"
                    class="inline-flex min-h-10 items-center font-semibold text-red-600 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300"
                  >
                    {gettext("Forget")}
                  </.link>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </:footnote>
    </.toggle_form_card>

    <%!-- The remaining in-app notifications are not configurable (they are the
          product), so this card just explains them and links to the bell. --%>
    <.card>
      <.section_title>{gettext("In-app notifications")}</.section_title>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
        {gettext("These are always on. You see them under the bell at the top of every page, in real time.")}
      </p>
      <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-slate-600 dark:text-slate-400">
        <li>{gettext("New messages and new connections")}</li>
        <li>{gettext("Endorsements and new followers")}</li>
        <li>{gettext("Replies to and likes on your posts")}</li>
      </ul>
      <p class="mt-4">
        <.link
          navigate={~p"/notifications"}
          class="text-sm font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300"
        >
          {gettext("Open your notifications")} ›
        </.link>
      </p>
    </.card>
  </div>
</.settings_shell>
