<%!-- The Markdown help page (a kit page). Same footprint as the developer docs:
a wide content column with a slim rail, so a long reference page keeps a
readable measure and its table of contents is one click away on a desktop. On a
phone the contents card sits above the text (order-first), because scrolling
past a 20-entry list to reach the first sentence is worse than a tap. --%>
<div class="py-6">
  <header class="mb-6">
    <h1 class="text-2xl font-bold text-slate-900 dark:text-white">{@page_title}</h1>
  </header>

  <div class="grid gap-6 md:grid-cols-4">
    <%!-- min-w-0: below md the grid falls back to an implicit `auto` track, so a
    long code line in an example would otherwise widen the whole page. --%>
    <div class="min-w-0 md:col-span-3">
      <.card>
        <div class="markdown text-slate-800 dark:text-slate-200">
          {raw(@body)}
        </div>
      </.card>
    </div>

    <aside class="order-first space-y-6 md:order-none">
      <.card>
        <.section_title>{gettext("On this page")}</.section_title>
        <ul class="mt-3 space-y-2 text-sm font-medium">
          <li :for={{anchor, label} <- @contents}>
            <a
              href={"##{anchor}"}
              class="text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300"
            >
              {label}
            </a>
          </li>
        </ul>
        <p class="mt-4 border-t border-slate-100 pt-3 text-sm dark:border-slate-800">
          <.link
            href={~p"/system/markdown" <> ".md"}
            class="text-slate-600 hover:text-brand-700 dark:text-slate-400 dark:hover:text-brand-300"
          >
            {gettext("Read this page as Markdown")}
          </.link>
        </p>
      </.card>
    </aside>
  </div>
</div>
