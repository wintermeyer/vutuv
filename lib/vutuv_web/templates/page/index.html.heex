<.auth_layout title={founder_quote(@landing_variant)}>
  <:headline>
    <%!-- Two headlines are under test (VutuvWeb.LandingExperiment); this
          visitor keeps the one their session was assigned. --%>
    <% founder_quote = founder_quote(@landing_variant) %>
    <% founder_name = "Stefan Wintermeyer" %>
    <% founder_role = gettext("Founder of vutuv") %>
    <%!-- Founder hero: the whole quote in one heading at a single size, then a
          right-aligned signature with the name above the role, set snug. The
          member-count pill below is shared from the :hero slot. --%>
    <div>
      <h1 class="text-2xl font-bold leading-tight md:text-3xl">
        {founder_quote}
      </h1>
      <div class="mt-6 text-right">
        <p class="font-serif text-2xl leading-none text-white">
          <a
            href="https://vutuv.de/wintermeyer"
            class="text-white underline decoration-brand-200 underline-offset-4 hover:decoration-white"
          >
            {founder_name}
          </a>
        </p>
        <p class="-mt-2 text-sm text-brand-100">{founder_role}</p>
      </div>
    </div>
  </:headline>
  <h2 class="text-xl font-bold text-slate-900 dark:text-white">
    {gettext("Create your free account")}
  </h2>

  <%!-- The sign-up form is grouped into three blocks (who you are / your email
        / privacy) divided by hairlines, so the fields read as three digestible
        sections instead of one long, undifferentiated list. Shared class/option
        bindings keep the repeated radio groups and consent checkboxes
        consistent. --%>
  <% gender_options = [{gettext("male"), "male"}, {gettext("female"), "female"}, {gettext("other"), "other"}] %>
  <%!-- Order and default come from the schema (Vutuv.Accounts.Email.email_types/0),
        so the form can never offer a value the changeset rejects: Privat, Arbeit,
        Andere - with Privat preselected by the controller. --%>
  <% email_type_options = Enum.map(Email.email_types(), &{email_type_label(&1), &1}) %>
  <% radio_class = "h-4 w-4 border-slate-300 text-brand-600 focus:ring-brand-500 dark:border-slate-600 dark:bg-slate-800" %>
  <% legend_class = "mb-1.5 text-sm font-semibold text-slate-700 dark:text-slate-300" %>
  <% radio_label_class = "flex items-center gap-2 text-sm font-normal text-slate-700 dark:text-slate-200" %>
  <% check_label_class = "flex items-start gap-2 text-sm text-slate-600 dark:text-slate-300" %>

  <.form
    :let={f}
    for={@changeset}
    action={~p"/new_registration"}
    multipart
    class="mt-5 space-y-6"
    id="registration-form"
  >
    <.form_error changeset={@changeset} />

    <%!-- Group 1: who you are. A radio group, not a dropdown: all options are
          visible and "männlich" is preselected (set on the changeset by the
          controller), so a normal user is not left on an empty
          "Geschlecht auswählen" prompt. --%>
    <div class="space-y-4">
      <fieldset>
        <legend class={legend_class}>{gettext("Gender")}</legend>
        <div class="flex flex-wrap gap-x-5 gap-y-2">
          <%= for {glabel, gvalue} <- gender_options do %>
            <label class={radio_label_class}>
              <%= radio_button f, :gender, gvalue, class: radio_class, autofocus: gvalue == "male" %>
              <span>{glabel}</span>
            </label>
          <% end %>
        </div>
        <%= error_tag f, :gender %>
      </fieldset>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= text_input f, :first_name, class: input_class(f, :first_name), placeholder: gettext("Enter your first name"), "aria-invalid": f.errors[:first_name] && "true" %>
          <%= error_tag f, :first_name %>
        </div>
        <div>
          <%= text_input f, :last_name, class: input_class(f, :last_name), placeholder: gettext("Enter your last name"), "aria-invalid": f.errors[:last_name] && "true" %>
          <%= error_tag f, :last_name %>
        </div>
      </div>
      <div>
        <.tag_input
          id="signup-tags"
          field_id={f[:tag_list].id}
          name={f[:tag_list].name}
          value={f[:tag_list].value || ""}
          placeholder={gettext("Your tags (e.g. JavaScript, Cooking, Origami, Cat)")}
          field_class={input_class(f, :tag_list)}
          invalid?={f.errors[:tag_list] != nil}
          aria-invalid={f.errors[:tag_list] && "true"}
        />
        <%!-- Tags are how members are found, so sign-up asks for at least
              three (enforced by the registration changeset). On a failed
              submit the specific error replaces the hint — the two would say
              nearly the same thing, and one clear line beats a red-on-grey
              stack. The input itself turns red via input_class/2. --%>
        <%= error_tag f, :tag_list %>
        <p :if={!f.errors[:tag_list]} class="mt-1 text-sm text-slate-600 dark:text-slate-400">{gettext("At least three tags, separated by commas. A tag may be several words long, like Ruby on Rails.")}</p>
      </div>
    </div>

    <%!-- Group 2: email. The email-type choice comes first (above the address
          field): a radio group, not a dropdown, so a normal user sees all three
          choices at once, and "Work" is preselected (set on the changeset by
          the controller) instead of the old unhelpful "Other" default. --%>
    <div class="space-y-4 border-t border-slate-200 pt-6 dark:border-slate-800">
      <.inputs_for :let={ef} field={f[:emails]}>
        <fieldset>
          <legend class={legend_class}>{gettext("Type of email address")}</legend>
          <div class="flex flex-wrap gap-x-5 gap-y-2">
            <%= for {elabel, evalue} <- email_type_options do %>
              <label class={radio_label_class}>
                <%= radio_button ef, :email_type, evalue, class: radio_class %>
                <span>{elabel}</span>
              </label>
            <% end %>
          </div>
          <%= error_tag ef, :email_type %>
        </fieldset>
        <div>
          <%= email_input ef, :value, class: input_class(ef, :value), placeholder: gettext("Enter your email address"), "aria-invalid": ef.errors[:value] && "true" %>
          <%= error_tag ef, :value %>
        </div>
        <%!-- Checked by default (the controller primes public?: true on the
              changeset), so a normal member's address shows on their profile
              unless they opt out here. --%>
        <label class={check_label_class}>
          <%= checkbox ef, :public?, class: checkbox_class() %>
          <span>{gettext("Allow others to view your email address")}</span>
          <%= error_tag ef, :public? %>
        </label>
      </.inputs_for>
    </div>

    <%!-- Group 3: reach. Positive, opt-in phrasing to match the email
          checkbox above, and every box checked by default. The first two
          fields are inverted: the box reads positively ("Allow ...") while the
          underlying `noindex?` / `noai?` flags are negative, so a checked box
          submits "false" (allow). The SEO question (search engines), the GEO
          question (AI agents / LLMs) and the Fediverse question (other social
          networks) are asked separately, since a member may say yes to one and
          no to the next. --%>
    <div class="space-y-3 border-t border-slate-200 pt-6 dark:border-slate-800">
      <label class={check_label_class}>
        <%= checkbox f, :noindex?, checked_value: "false", unchecked_value: "true", class: checkbox_class() %>
        <%!-- The "(SEO)" / "(GEO)" tags are international (same in DE/EN), so they
              are literal text outside gettext rather than part of the string. --%>
        <span>{gettext("Allow search engines to index your profile")} (SEO)</span>
        <%= error_tag f, :noindex? %>
      </label>
      <label class={check_label_class}>
        <%= checkbox f, :noai?, checked_value: "false", unchecked_value: "true", class: checkbox_class() %>
        <span>{gettext("Allow AI agents and LLMs to use your profile")} (GEO)</span>
        <%= error_tag f, :noai? %>
      </label>
      <%!-- The third "who may reach this profile" question (Vutuv.Fediverse),
            and the one that is NOT inverted: checked means taking part.
            Pre-checked by the controller, because most people who join want it
            and this is the only moment they are asked; /settings/fediverse
            takes it back at any time. The label is deliberately the same
            sentence as the switch on that page, so the member recognizes the
            thing they are looking for later.

            One box, all three of that page's switches (see
            PageController.expand_fediverse_choice/1) — which is exactly why
            this box carries three lines of explanation where the other two
            carry none. It is the only choice on this form that is not just
            about the member's own data: ticking it means answers written by
            people who never signed up here are stored on our server, so the
            text has to say that, and say for how long, before the tick counts
            as consent to it. Left out entirely where the installation
            federates nothing (FEDIVERSE_ENABLED=false, intranets). --%>
      <label :if={Vutuv.Fediverse.enabled?()} class={check_label_class}>
        <%= checkbox f, :fediverse_followers?, class: checkbox_class() %>
        <span>
          {gettext("Take part in the Fediverse")}
          <%!-- `font-normal` is not decoration: components.css sets every
                <label> bold, which the three box labels want and this helper
                line does not - without it the explanation shouts as loudly as
                the choice it explains. --%>
          <span class="mt-0.5 block text-xs font-normal text-slate-600 dark:text-slate-400">
            {gettext(
              "People on Mastodon and other independent networks can then follow this profile, and your public posts appear there. What they answer or share comes back and is shown under your posts, by their account address. A reply from there is stored here for up to six months. You can switch all of it off again at any time."
            )}
          </span>
        </span>
        <%= error_tag f, :fediverse_followers? %>
      </label>
    </div>

    <.button type="submit" class="w-full">{gettext("Sign up for a free account")}</.button>

    <%!-- Consent / information notice by the button. Accepting the
          Nutzungsbedingungen at sign-up is what incorporates the AGB into the
          contract (§305 BGB); the Datenschutzerklärung is information we must
          surface (GDPR Art. 13), not a consent. The sentence is one gettext
          string with two ordered placeholders we split on, so both links sit
          in their natural place in German and English alike. --%>
    <% {nb_pre, nb_rest} =
      split_marker(
        gettext(
          "By creating an account you accept our {nutzungsbedingungen} and confirm that you have read our {datenschutz}."
        ),
        "{nutzungsbedingungen}"
      ) %>
    <% {ds_mid, ds_post} = split_marker(nb_rest, "{datenschutz}") %>
    <p class="text-center text-xs text-slate-600 dark:text-slate-400">
      {nb_pre}<a href={~p"/nutzungsbedingungen"} class="font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300">{gettext("Nutzungsbedingungen")}</a>{ds_mid}<a href={~p"/datenschutzerklaerung"} class="font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300">{gettext("Datenschutzerklärung")}</a>{ds_post}
    </p>

    <p class="text-center text-sm">
      <a href={~p"/login"} class="font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300">{gettext("Already a member? Sign in here.")}</a>
    </p>

    <p class="text-xs text-slate-600 dark:text-slate-400">{gettext("We reserve the right to stop this service or delete your account anytime without warning.")}</p>
  </.form>
</.auth_layout>

<%!-- Everything below the sign-up card is the answer to "what IS this?", which
      the form alone never gave a first-time visitor. It sits under the form on
      purpose: the form is the conversion path and keeps the top of the page.
      Same max-w-5xl as <.auth_layout> so every edge on the page lines up.

      Every example here is a static screenshot, and that is a decision rather
      than a shortcut. A picture names nobody, so nobody has to agree to being
      on the front page; it shows a whole page at once the way a card never
      could; and it costs one lazily loaded image instead of a socket. A wall of
      real, current posts used to sit under these blocks as the proof that the
      site is alive. It was dropped because it was not paying for itself: a
      carousel over its own LiveView, a cached snapshot behind it and a query
      per refresh, on the page that greets every crawler. --%>
<div class="mx-auto max-w-5xl space-y-12 pb-12">
  <section>
    <%!-- "Readable without an account" was jargon nobody outside the project
          parses. Say who can do what, then name the thing everybody has
          actually run into. --%>
    <.landing_heading
      eyebrow={gettext("A look inside")}
      title={gettext("This is what a vutuv profile looks like")}
      lead={
        gettext(
          "Work experience, education, certificates, languages, links and tags others endorse you for. Anyone can read a profile, entirely without a vutuv account. Unlike LinkedIn, where you hit a login wall in short order."
        )
      }
    />
    <%!-- A real, readable profile right under the pictures, because "readable
          without an account" is a claim anybody can check in one click and the
          screenshots alone cannot. The URL is configurable
          (LANDING_EXAMPLE_PROFILE_URL) and the whole line drops out where an
          installation cleared it. --%>
    <.try_it_out />

    <.shot_deck deck={:profile} />

    <p class="mt-8 text-center">
      <a
        href={~p"/system/members"}
        class="text-sm font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300"
      >
        {gettext("Browse real profiles")} <span aria-hidden="true">›</span>
      </a>
    </p>
  </section>

  <%!-- The two sections a visitor who is mid-application actually came for, and
        the reason they sit this high: the block above answers "what is this",
        and these answer "what do I get out of it", which is the question
        somebody with a job application open is actually deciding.

        They are two sections and not one, although both are about job
        applications, because they promise opposite things. The CV is something
        you hand OUT, so its section ends in a link anybody can open. The
        Arbeitszeugnis is something you show nobody, so its section spends its
        last two lines on where the document stays and on what the review is
        not. Folded together, the privacy half is what gets lost. --%>
  <section>
    <.landing_heading
      eyebrow={gettext("Job applications")}
      title={gettext("Your CV, ready to send")}
      lead={
        gettext(
          "What your profile already says becomes a CV. You tick what should go in, then download it as PDF, Word, OpenDocument, LaTeX or JSON Resume. Anonymously as well, if you would rather show what you can do before you show who you are."
        )
      }
    />
    <%!-- The CV builder is public, so the claim above is one click away. Same
          setting as the profile link above, so an installation that cleared it
          loses both rather than keeping a half-configured page. --%>
    <.try_it_out suffix="/cv" />

    <.shot_deck deck={:career} />
  </section>

  <%!-- Gated on the review queue's own switch, the way the Fediverse section is
        gated on federation: an installation with no model behind it
        (`REFERENCE_CHECKS_ENABLED=false`) can still store references, but the
        grading this section is named after never happens there, and a heading
        promising it would be the operator's front page lying. --%>
  <section :if={Checks.enabled?()}>
    <.landing_heading
      eyebrow={gettext("Employment reference")}
      title={gettext("What your employment reference really says")}
      lead={
        gettext(
          "Upload your employment references and have them read sentence by sentence: a grade, a traffic light, and the explanation of how a recruiter reads that wording. It takes a few minutes, then the report is there. Nothing becomes public before you release it."
        )
      }
    />
    <.shot_deck deck={:reference} />

    <%!-- Two closing lines, and neither is decoration. The first is the whole
          reason to hand a document like this to us rather than to a chatbot,
          and it is quoted from the feature page so the two cannot disagree. The
          second is the boundary: the analysis prompt deliberately refuses to
          draft a Berichtigungsverlangen or a Klagestrategie (§ 2 RDG), so the
          start page must not promise one. --%>
    <p class="mt-6 text-base leading-relaxed text-slate-700 dark:text-slate-300">
      {reference_privacy_line()}
    </p>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
      {gettext(
        "The review is a text analysis, not legal advice, and it covers German employment references."
      )}
    </p>
  </section>

  <%!-- Gated on the installation's federation switch, like the sign-up form's
        Fediverse question is: with FEDIVERSE_ENABLED=false (the intranet case)
        every endpoint behind this 404s, so a section promising Mastodon would
        be a straight lie on the operator's front page. Both pictures and the
        larger half of the text are about federation, so the whole section goes
        rather than half of it — posts and messages are still named in the
        feature list below.

        The closing sentence is not decoration: plenty of people want a business
        network and no Fediverse at all, and they need to read that it is a
        choice they make at sign-up and can take back later, not something that
        happens to them. --%>
  <section :if={Fediverse.enabled?()}>
    <.landing_heading
      eyebrow={gettext("Talking to people")}
      title={gettext("Posts, messages, and the Fediverse along with them")}
      lead={
        gettext(
          "Write a post, react with a heart, a repost or a reply, or message somebody privately. And you are not stuck among vutuv members: vutuv is part of the Fediverse, the union of independent networks that Mastodon belongs to as well. Follow an account over there and its posts arrive in your feed; the other way round, people there can follow you and see your public posts. Both directions, and entirely your choice: at sign-up you decide whether to use vutuv with or without the Fediverse, and you can change that at any time in the settings."
        )
      }
    />
    <.shot_deck deck={:communication} />
  </section>

  <section>
    <.landing_heading
      eyebrow={gettext("What you get")}
      title={gettext("What vutuv can do")}
      lead={
        gettext(
          "A business network that is free, does not lock your data in, and is yours to run yourself if you want to."
        )
      }
    />
    <.landing_features />
  </section>

  <section>
    <.landing_heading
      eyebrow={gettext("Open by default")}
      title={gettext("Readable by people, by machines, and on your own server")}
      lead={
        gettext(
          "Every public page here is also served as Markdown, plain text, JSON and XML under the same address. No scraping, no API key, no account."
        )
      }
    />
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <.card>
        <.section_title>{gettext("For machines")}</.section_title>
        <div class="mt-3 flex flex-wrap gap-2">
          <%!-- Live links, not a list of formats we claim to support: whoever
                doubts it is one click from the document itself. --%>
          <.landing_format_chips />
        </div>
        <%!-- RSS is a chip of its own now, so it is out of this sentence: the
              list is what the chips do NOT already show. --%>
        <p class="mt-4 text-sm text-slate-600 dark:text-slate-400">
          {gettext(
            "Plus a sitemap, JSON-LD and a REST API with OAuth 2 and personal access tokens."
          )}
        </p>
      </.card>

      <.card>
        <.section_title>{gettext("Run it yourself")}</.section_title>
        <p class="mt-3 text-sm text-slate-700 dark:text-slate-300">
          {gettext(
            "vutuv is open source under the MIT license. Run it for a company, an association or a school, on the internet or air-gapped inside your own network."
          )}
        </p>
        <p class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm font-semibold">
          <a
            href="https://github.com/wintermeyer/vutuv"
            class="text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300"
          >
            {gettext("Source code")} <span aria-hidden="true">↗</span>
          </a>
          <a
            href={~p"/developers"}
            class="text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300"
          >
            {gettext("Developer documentation")} <span aria-hidden="true">›</span>
          </a>
        </p>
      </.card>
    </div>
  </section>


  <%!-- Last, because it answers the question somebody asks once they have
        decided they like the place: what happens to what I put in?

        The four promises are deliberately of two kinds. Three are properties of
        the SOFTWARE and hold on every installation — no third-party cookies
        (verified: production sets exactly one, `_vutuv_key`, and the HTML loads
        nothing from another host), the GDPR export, and self-service deletion,
        both reachable from every account. The fourth, where the servers stand,
        is the operator's alone (:data_location) and drops out entirely where
        they cleared it. Mixing the two would have put a claim on somebody
        else's front page that only we can keep. --%>
  <section>
    <.landing_heading
      eyebrow={gettext("Your data")}
      title={gettext("Fair and transparent, in plain words")}
    />
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <.card :if={data_location()}>
        <.section_title>{gettext("Where your data lives")}</.section_title>
        <p class="mt-3 text-sm text-slate-700 dark:text-slate-300">
          {gettext(
            "On our own servers in %{place}, not in somebody else's cloud. We do not hand your profile to a third party, and there is no tracking network reading along.",
            place: data_location()
          )}
        </p>
      </.card>

      <.card>
        <.section_title>{gettext("No third-party cookies")}</.section_title>
        <p class="mt-3 text-sm text-slate-700 dark:text-slate-300">
          {gettext(
            "vutuv sets one cookie, the one that keeps you signed in. No advertising network, no analytics service, nothing loaded from anybody else's server."
          )}
        </p>
      </.card>

      <.card>
        <.section_title>{gettext("Your data stays with you")}</.section_title>
        <p class="mt-3 text-sm text-slate-700 dark:text-slate-300">
          {gettext(
            "Download everything you have here at any time, in a machine-readable file. Not on request, not after a waiting period: from your settings, whenever you like."
          )}
        </p>
      </.card>

      <.card>
        <.section_title>{gettext("Leave whenever you like")}</.section_title>
        <p class="mt-3 text-sm text-slate-700 dark:text-slate-300">
          <%!-- "You are welcome back" is a checkable claim, not a nicety:
                deleting an account hard-deletes the row and cascades its email
                addresses away (add_cascade_deletes_on_user_associations), so the
                address is free again and nothing on the sign-up path holds it
                against you. --%>
          {gettext(
            "Delete your account yourself, without writing to anybody. No questions asked, and you are welcome back any time."
          )}
        </p>
      </.card>

      <%!-- Full width and last, because it is the one that backs the other
            four: they are claims, and this is how you check them. --%>
      <.card class="md:col-span-2">
        <.section_title>{gettext("Open source")}</.section_title>
        <p class="mt-3 text-sm text-slate-700 dark:text-slate-300">
          {gettext(
            "You can check at any time how exactly vutuv works. The whole source code is public under the MIT license, so everything said above about your data can be read rather than taken on trust."
          )}
        </p>
        <p class="mt-4 text-sm font-semibold">
          <a
            href="https://github.com/wintermeyer/vutuv"
            class="text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300"
          >
            {gettext("Source code")} <span aria-hidden="true">↗</span>
          </a>
        </p>
      </.card>
    </div>
  </section>
</div>

<JsonLd.script data={JsonLd.organization()} />
<JsonLd.script data={JsonLd.web_site()} />
