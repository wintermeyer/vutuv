<div class="mx-auto max-w-5xl px-4 py-8 sm:py-12">
  <div class="mb-8">
    <.link href={Vutuv.Posts.path(@post)} class="text-sm font-medium text-brand-700 hover:underline dark:text-brand-300">
      ← {gettext("Back to post")}
    </.link>
    <h1 class="mt-5 text-3xl font-semibold tracking-tight text-slate-950 dark:text-white sm:text-4xl">
      {gettext("How this post travelled")}
    </h1>
    <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600 dark:text-slate-400">
      {gettext("A timeline of recorded likes, reposts and public replies. These are interactions, not measured views or unique reach.")}
    </p>
  </div>

  <div class="mb-7 flex flex-wrap items-end gap-x-8 gap-y-5 border-y border-slate-200 py-5 dark:border-slate-700">
    <div class="min-w-40">
      <p class="text-sm text-slate-600 dark:text-slate-400">{gettext("Interactions in selected period")}</p>
      <p class="mt-1 text-4xl font-semibold tabular-nums tracking-tight text-slate-950 dark:text-white">{@analytics.totals.all}</p>
    </div>
    <dl class="flex flex-wrap gap-x-7 gap-y-3 pb-1 text-sm">
      <div><dt class="inline text-slate-600 dark:text-slate-400">{gettext("Likes")}</dt> <dd class="inline font-semibold tabular-nums text-brand-700 dark:text-brand-300">{@analytics.totals.likes}</dd></div>
      <div><dt class="inline text-slate-600 dark:text-slate-400">{gettext("Reposts")}</dt> <dd class="inline font-semibold tabular-nums text-cyan-700 dark:text-cyan-300">{@analytics.totals.reposts}</dd></div>
      <div><dt class="inline text-slate-600 dark:text-slate-400">{gettext("Replies")}</dt> <dd class="inline font-semibold tabular-nums text-amber-700 dark:text-amber-300">{@analytics.totals.replies}</dd></div>
    </dl>
  </div>

  <section class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900 sm:p-8" aria-labelledby="analytics-chart-heading">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h2 id="analytics-chart-heading" class="text-xl font-semibold text-slate-950 dark:text-white">
          {gettext("Interactions over time")}
        </h2>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
          {if @analytics.unit == "hour", do: gettext("Per hour"), else: gettext("Per day")}
        </p>
      </div>
      <nav aria-label={gettext("Time range")} class="flex rounded-xl bg-slate-100 p-1 dark:bg-slate-800">
        <.link :for={range <- Vutuv.PostAnalytics.ranges()} href={~p"/posts/#{@post.id}/analytics?range=#{range}"}
          aria-current={if range == @analytics.range, do: "page"}
          class={[
            "rounded-lg px-3 py-1.5 text-sm font-medium transition-colors",
            if(range == @analytics.range,
              do: "bg-white text-slate-950 shadow-sm dark:bg-slate-700 dark:text-white",
              else: "text-slate-600 hover:text-slate-950 dark:text-slate-300 dark:hover:text-white")
          ]}>
          {range_label(range)}
        </.link>
      </nav>
    </div>

    <div :if={@analytics.totals.all == 0} class="mt-8 rounded-2xl bg-slate-50 px-5 py-10 text-center dark:bg-slate-800">
      <p class="font-medium text-slate-800 dark:text-slate-100">{gettext("No recorded interactions in this period")}</p>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{gettext("Try a longer time range, or check back later.")}</p>
    </div>

    <div :if={@analytics.totals.all > 0} class="mt-8">
      <div class="mb-4 flex flex-wrap gap-x-5 gap-y-2 text-xs font-medium text-slate-600 dark:text-slate-300">
        <span><span class="mr-1.5 inline-block h-2.5 w-2.5 rounded-sm bg-brand-500"></span>{gettext("Likes")}</span>
        <span><span class="mr-1.5 inline-block h-2.5 w-2.5 rounded-sm bg-cyan-500"></span>{gettext("Reposts")}</span>
        <span><span class="mr-1.5 inline-block h-2.5 w-2.5 rounded-sm bg-amber-500"></span>{gettext("Replies")}</span>
      </div>
      <div class="overflow-x-auto">
        <svg viewBox="0 0 760 260" role="img" aria-labelledby="chart-title chart-desc" class="h-auto min-w-[620px] w-full">
          <title id="chart-title">{gettext("Recorded interactions over time")}</title>
          <desc id="chart-desc">{gettext("Stacked bars show likes, reposts and replies in each time interval. The highest interval is highlighted below.")}</desc>
          <line x1="34" x2="748" y1="218" y2="218" stroke="currentColor" class="text-slate-300 dark:text-slate-600" />
          <line x1="34" x2="748" y1="118" y2="118" stroke="currentColor" stroke-dasharray="3 5" class="text-slate-200 dark:text-slate-700" />
          <line x1="34" x2="748" y1="18" y2="18" stroke="currentColor" stroke-dasharray="3 5" class="text-slate-200 dark:text-slate-700" />
          <text x="4" y="221" class="fill-slate-500 text-[11px] dark:fill-slate-400">0</text>
          <text x="4" y="121" class="fill-slate-500 text-[11px] dark:fill-slate-400">{div(@analytics.peak.total, 2)}</text>
          <text x="4" y="21" class="fill-slate-500 text-[11px] dark:fill-slate-400">{@analytics.peak.total}</text>
          <g :for={{bucket, index} <- Enum.with_index(@analytics.buckets)}>
            <% x = 36 + index * 710 / length(@analytics.buckets) %>
            <% width = max(2, 710 / length(@analytics.buckets) - 1) %>
            <% scale = 200 / max(@analytics.peak.total, 1) %>
            <rect :if={bucket.likes > 0} x={x} y={218 - bucket.likes * scale} width={width} height={bucket.likes * scale} fill="#8b5cf6">
              <title>{bucket_label(bucket.at, @analytics.unit)}: {bucket.likes} {gettext("likes")}</title>
            </rect>
            <rect :if={bucket.reposts > 0} x={x} y={218 - (bucket.likes + bucket.reposts) * scale} width={width} height={bucket.reposts * scale} fill="#06b6d4">
              <title>{bucket_label(bucket.at, @analytics.unit)}: {bucket.reposts} {gettext("reposts")}</title>
            </rect>
            <rect :if={bucket.replies > 0} x={x} y={218 - bucket.total * scale} width={width} height={bucket.replies * scale} fill="#f59e0b">
              <title>{bucket_label(bucket.at, @analytics.unit)}: {bucket.replies} {gettext("replies")}</title>
            </rect>
          </g>
          <text x="34" y="246" class="fill-slate-500 text-[11px] dark:fill-slate-400">{bucket_label(hd(@analytics.buckets).at, @analytics.unit)}</text>
          <text x="748" y="246" text-anchor="end" class="fill-slate-500 text-[11px] dark:fill-slate-400">{bucket_label(List.last(@analytics.buckets).at, @analytics.unit)}</text>
        </svg>
      </div>
      <p class="mt-1 text-xs text-slate-500 dark:text-slate-400 sm:hidden">
        {gettext("Swipe across the chart to explore the full timeline.")}
      </p>
      <div class="mt-5 rounded-xl bg-brand-50 p-4 dark:bg-brand-950/40">
        <p class="text-sm font-semibold text-brand-900 dark:text-brand-100">
          {gettext("Busiest interval")}: {@analytics.peak.total} {gettext("interactions")}
        </p>
        <p class="mt-1 text-sm text-brand-800 dark:text-brand-200">{bucket_label(@analytics.peak.at, @analytics.unit)}</p>
      </div>
    </div>
  </section>

  <p class="mt-5 max-w-3xl text-xs leading-5 text-slate-500 dark:text-slate-400">
    {gettext("This chart uses reactions still stored by vutuv. Removed likes, deleted replies and activity that another server never delivered cannot be reconstructed. Times are shown in UTC.")}
  </p>
</div>
