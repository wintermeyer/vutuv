<div class="mx-auto max-w-6xl px-4 py-8 sm:py-12">
  <div class="mb-7 flex flex-wrap items-start justify-between gap-4">
    <div>
      <.link href={Vutuv.Posts.path(@post)} class="text-sm font-medium text-brand-700 hover:underline dark:text-brand-300">← {gettext("Back to post")}</.link>
      <div class="mt-5 flex items-center gap-3">
        <h1 class="text-3xl font-semibold tracking-tight text-slate-950 dark:text-white sm:text-4xl">{gettext("Reach analysis")}</h1>
        <span class="rounded-full bg-brand-100 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-brand-800 dark:bg-brand-950 dark:text-brand-200">Beta</span>
      </div>
    </div>
    <div>
      <p class="mb-1.5 text-xs font-medium text-slate-500 dark:text-slate-400">{gettext("Chart period")}</p>
      <nav aria-label={gettext("Chart period")} class="flex rounded-xl bg-slate-100 p-1 dark:bg-slate-800">
        <.link :for={range <- Vutuv.PostAnalytics.ranges()} href={~p"/posts/#{@post.id}/analytics?range=#{range}"} aria-current={if range == @analytics.range, do: "page"} class={["rounded-lg px-3 py-1.5 text-sm font-medium", if(range == @analytics.range, do: "bg-white text-slate-950 shadow-sm dark:bg-slate-700 dark:text-white", else: "text-slate-600 dark:text-slate-300")]}>{range_label(range)}</.link>
      </nav>
    </div>
  </div>

  <section class="mt-7 overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900" aria-labelledby="repost-reach-heading">
    <div class="grid gap-6 p-5 sm:p-8 lg:grid-cols-[.7fr_1.3fr]">
      <div>
        <h2 id="repost-reach-heading" class="text-xl font-semibold text-slate-950 dark:text-white">{gettext("Potential reach from reposts")}</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">{gettext("Known follower totals of people who reposted. This is potential distribution, not readership.")}</p>
        <p class="mt-6 text-5xl font-semibold tracking-tight text-slate-950 dark:text-white">{compact_count(@analytics.repost_reach.known)}<span class="text-brand-500">+</span></p>
        <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">{gettext("%{known} known · %{unknown} unavailable", known: @analytics.repost_reach.known_reposters, unknown: @analytics.repost_reach.unknown_reposters)}</p>
      </div>
      <div :if={@analytics.repost_reach.visible_reposters != []} class="space-y-3">
        <% max_followers = @analytics.repost_reach.visible_reposters |> Enum.map(&(&1.followers || 0)) |> Enum.max(fn -> 0 end) %>
        <div :for={reposter <- @analytics.repost_reach.visible_reposters} class="grid grid-cols-[minmax(8rem,1fr)_2fr_auto] items-center gap-3 text-xs">
          <span class="truncate font-medium text-slate-700 dark:text-slate-200" title={reposter.label}>{reposter.label}</span>
          <div class="h-3 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800">
            <div :if={not is_nil(reposter.followers)} data-repost-reach-bar class="h-full rounded-full bg-gradient-to-r from-brand-500 to-fuchsia-400" style={"width: #{repost_reach_bar_width(reposter, max_followers)}%"}></div>
            <div :if={is_nil(reposter.followers)} class="mt-1 h-px w-full border-t border-dashed border-slate-400"></div>
          </div>
          <span class="w-14 text-right font-semibold tabular-nums text-slate-700 dark:text-slate-200">{if is_nil(reposter.followers), do: gettext("unknown"), else: compact_count(reposter.followers)}</span>
        </div>
      </div>
      <p :if={@analytics.repost_reach.visible_reposters == []} class="self-center text-sm text-slate-500 dark:text-slate-400">{gettext("No reposts recorded.")}</p>
    </div>
    <details class="border-t border-slate-200 px-5 py-4 text-sm dark:border-slate-700 sm:px-8">
      <summary class="cursor-pointer font-medium text-slate-800 dark:text-slate-100">{gettext("How this is calculated")}</summary>
      <div class="mt-3 max-w-3xl space-y-2 leading-6 text-slate-600 dark:text-slate-400">
        <p>{gettext("Follower totals are fetched in the background from public ActivityPub collections or Mastodon APIs and stored with a timestamp.")}</p>
        <p>{gettext("Each reposter is counted once. Missing totals are excluded, so + marks a lower bound.")}</p>
        <p>{gettext("Followers can overlap, and a delivered post may not be read. The figure is not a count of unique readers.")}</p>
      </div>
    </details>
  </section>

  <section class="mt-7 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900 sm:p-8" aria-labelledby="network-heading">
      <h2 id="network-heading" class="text-xl font-semibold text-slate-950 dark:text-white">{gettext("Server network")}</h2>
      <p class="mt-1 max-w-3xl text-sm leading-6 text-slate-600 dark:text-slate-400">{gettext("Numbers inside nodes are visible interactions. The numbered spiral follows the first reaction from each server. Repost hops between servers are not visible to vutuv.")}</p>
      <div class="mt-3 flex flex-wrap gap-4 text-xs text-slate-600 dark:text-slate-400"><span><span class="mr-1.5 inline-block h-2.5 w-2.5 rounded-full bg-brand-500"></span>{gettext("Reacted")}</span><span><span class="mr-1.5 inline-block h-2.5 w-2.5 rounded-full border border-slate-400"></span>{gettext("Contacted only")}</span><span><span class="mr-1.5 inline-flex h-4 min-w-4 items-center justify-center rounded-full bg-fuchsia-500 px-1 text-[9px] font-bold text-white">1</span>{gettext("Reaction order")}</span><span><span class="mr-1.5 inline-block h-3.5 w-3.5 rounded-full border-2 border-cyan-400 align-middle"></span>{gettext("Outer ring: monthly active accounts")}</span><span><span class="mr-1.5 inline-block h-0.5 w-5 bg-fuchsia-400 align-middle"></span>{gettext("Line width: known repost audience")}</span></div>
      <div class="mt-5 overflow-x-auto rounded-2xl bg-slate-950">
        <svg viewBox="0 0 1100 780" role="img" aria-labelledby="network-title network-desc" class="h-auto min-w-[900px] w-full">
          <title id="network-title">{gettext("Servers involved in this post")}</title>
          <desc id="network-desc">{gettext("A network map centered on vutuv. Later first reactions sit farther from the center. Node size and labels show visible interactions.")}</desc>
          <circle cx="550" cy="370" r="175" fill="none" stroke="#8b5cf6" stroke-dasharray="3 8" opacity=".2" />
          <circle cx="550" cy="370" r="300" fill="#8b5cf6" opacity=".07" />
          <text x="560" y="190" class="fill-slate-500 text-[10px]">{gettext("earlier")}</text>
          <text x="560" y="65" class="fill-slate-500 text-[10px]">{gettext("later")}</text>
          <g :for={{node, index} <- Enum.with_index(@analytics.network.visible_nodes)}>
            <% {x, y} = network_node_position(index, length(@analytics.network.visible_nodes)) %>
            <line :if={index > 0} data-network-repost-reach={node.repost_potential} x1="550" y1="370" x2={x} y2={y} stroke={if node.repost_potential > 0, do: "#e879f9", else: if(node.status == :active, do: "#8b5cf6", else: "#475569")} stroke-width={network_edge_width(node)} stroke-dasharray={if node.status == :addressed, do: "3 6"} />
          </g>
          <g :for={{node, index} <- Enum.with_index(@analytics.network.visible_nodes)}>
            <% {x, y} = network_node_position(index, length(@analytics.network.visible_nodes)) %>
            <circle :if={community_radius = network_community_radius(node)} data-community-size-ring cx={x} cy={y} r={community_radius} fill="none" stroke="#22d3ee" stroke-width="2" opacity=".8"><title>{network_node_title(node)}</title></circle>
            <circle cx={x} cy={y} r={network_node_radius(node)} fill={if node.status == :addressed, do: "#0f172a", else: if(node.status == :origin, do: "#7c3aed", else: "#8b5cf6")} stroke={if node.status == :addressed, do: "#94a3b8", else: "#c4b5fd"} stroke-width="2"><title>{network_node_title(node)}</title></circle>
            <text :if={node.status != :addressed} data-network-interactions x={x} y={y + 5} text-anchor="middle" class="fill-white text-[12px] font-bold">{node.interactions}</text>
            <g :if={node.sequence} data-network-sequence={node.sequence}>
              <circle cx={x - network_node_radius(node) + 1} cy={y - network_node_radius(node) + 1} r="10" fill="#d946ef" />
              <text x={x - network_node_radius(node) + 1} y={y - network_node_radius(node) + 4.5} text-anchor="middle" class="fill-white text-[9px] font-bold">{node.sequence}</text>
            </g>
            <text :if={index == 0} x={x} y={y + network_label_radius(node) + 16} text-anchor="middle" class="fill-slate-200 text-[11px] font-medium">{node.host}</text>
            <g :if={index > 0} data-network-label transform={network_label_transform(index, length(@analytics.network.visible_nodes), node)}>
              <text y="4" text-anchor={network_label_anchor(index, length(@analytics.network.visible_nodes))} class="fill-slate-100 text-[12px] font-semibold">{node.host}</text>
              <text :if={label = network_elapsed_label(node)} y="18" text-anchor={network_label_anchor(index, length(@analytics.network.visible_nodes))} class="fill-fuchsia-300 text-[10px]">{label}</text>
            </g>
          </g>
        </svg>
      </div>
      <p :if={@analytics.network.hidden_server_count > 0} class="mt-3 text-xs text-slate-500 dark:text-slate-400">{gettext("%{count} more servers are included in the total.", count: @analytics.network.hidden_server_count)}</p>
  </section>

  <section class="relative mt-7 overflow-hidden rounded-3xl bg-slate-950 px-6 py-8 text-white shadow-xl sm:px-9 sm:py-10">
    <div class="absolute -right-20 -top-28 h-72 w-72 rounded-full bg-brand-500/20 blur-3xl"></div>
    <div class="relative">
      <p class="max-w-3xl text-sm leading-6 text-slate-300">
        {gettext("Visible interactions are a")}
        <strong class="font-bold text-white">{gettext("lower bound")}</strong>,
        {gettext("not a view count.")}
      </p>
      <dl class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4"><dt class="text-xs text-slate-400">{gettext("People with visible interactions")}</dt><dd class="mt-2 text-3xl font-semibold tabular-nums">{@analytics.known_readers}<span class="text-lg text-brand-300">+</span></dd></div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4"><dt class="text-xs text-slate-400">{gettext("Servers involved")}</dt><dd class="mt-2 text-3xl font-semibold tabular-nums">{@analytics.network.server_count}</dd></div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4"><dt class="text-xs text-slate-400">{gettext("Interactions")}</dt><dd class="mt-2 text-3xl font-semibold tabular-nums">{@analytics.totals.all}</dd></div>
      </dl>
    </div>
  </section>

  <section class="mt-7 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900 sm:p-8" aria-labelledby="real-reach-heading">
    <h2 id="real-reach-heading" class="text-xl font-semibold text-slate-950 dark:text-white">{gettext("What is the real reach?")}</h2>
    <p class="mt-3 max-w-4xl text-base leading-7 text-slate-700 dark:text-slate-300">{gettext("We do not know whether the real reach is 10x, 100x or 1,000x larger. It cannot be tracked in the Fediverse.")}</p>
  </section>

  <section class="mt-7 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900 sm:p-8" aria-labelledby="analytics-chart-heading">
    <h2 id="analytics-chart-heading" class="text-xl font-semibold text-slate-950 dark:text-white">{gettext("Momentum over time")}</h2>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{if @analytics.unit == "hour", do: gettext("3-hour windows · UTC"), else: gettext("Per day · UTC")}</p>
    <div :if={@analytics.totals.all == 0} class="mt-8 rounded-2xl bg-slate-50 px-5 py-10 text-center dark:bg-slate-800"><p class="font-medium text-slate-800 dark:text-slate-100">{gettext("No recorded interactions in this period")}</p><p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{gettext("Try a longer time range, or check back later.")}</p></div>
    <div :if={@analytics.totals.all > 0} class="mt-8">
      <% chart_buckets = chart_buckets(@analytics.buckets, @analytics.unit) %>
      <% chart_peak = chart_peak(chart_buckets) %>
      <% chart_width = chart_width(chart_buckets, @analytics.unit) %>
      <% plot_width = chart_width - 50 %>
      <div class="mb-4 flex flex-wrap gap-x-5 gap-y-2 text-xs font-medium text-slate-600 dark:text-slate-300"><span><span class="mr-1.5 inline-block h-2.5 w-2.5 rounded-sm bg-brand-500"></span>{gettext("Likes")} {@analytics.totals.likes}</span><span><span class="mr-1.5 inline-block h-2.5 w-2.5 rounded-sm bg-cyan-500"></span>{gettext("Reposts")} {@analytics.totals.reposts}</span><span><span class="mr-1.5 inline-block h-2.5 w-2.5 rounded-sm bg-amber-500"></span>{gettext("Replies")} {@analytics.totals.replies}</span></div>
      <div class="overflow-x-auto"><svg viewBox={"0 0 #{chart_width} 286"} role="img" class="h-auto w-full" style={"min-width: #{chart_width}px"}>
        <g :if={@analytics.unit == "hour"} :for={{day, day_index} <- Enum.with_index(chart_day_labels(chart_buckets))}>
          <% day_x = 36 + day.index * plot_width / length(chart_buckets) %>
          <% day_width = day.count * plot_width / length(chart_buckets) %>
          <rect x={day_x} y="18" width={day_width} height="242" fill={if rem(day_index, 2) == 0, do: "#f8fafc", else: "#ffffff"} class="dark:fill-slate-800/40" />
          <line x1={day_x} x2={day_x} y1="18" y2="260" stroke="currentColor" class="text-slate-200 dark:text-slate-700" />
          <text data-chart-day-label x={day_x + day_width / 2} y="276" text-anchor="middle" class="fill-slate-600 text-[10px] font-semibold dark:fill-slate-300">{day.label}</text>
        </g>
        <line x1="34" x2={chart_width - 12} y1="218" y2="218" stroke="currentColor" class="text-slate-300 dark:text-slate-600" /><line x1="34" x2={chart_width - 12} y1="118" y2="118" stroke="currentColor" stroke-dasharray="3 5" class="text-slate-200 dark:text-slate-700" /><line x1="34" x2={chart_width - 12} y1="18" y2="18" stroke="currentColor" stroke-dasharray="3 5" class="text-slate-200 dark:text-slate-700" />
        <text x="4" y="221" class="fill-slate-500 text-[11px]">0</text><text x="4" y="121" class="fill-slate-500 text-[11px]">{div(chart_peak.total, 2)}</text><text x="4" y="21" class="fill-slate-500 text-[11px]">{chart_peak.total}</text>
        <g :for={{bucket, index} <- Enum.with_index(chart_buckets)} data-chart-bucket-label={bucket_label(bucket.at, @analytics.unit)}><title>{bucket_label(bucket.at, @analytics.unit)}</title><% x = 36 + index * plot_width / length(chart_buckets) %><% width = max(2, plot_width / length(chart_buckets) - 1) %><% scale = 200 / max(chart_peak.total, 1) %><rect x={x} y="18" width={width} height="200" fill="transparent" /><rect :if={bucket.likes > 0} x={x} y={218 - bucket.likes * scale} width={width} height={bucket.likes * scale} fill="#8b5cf6" /><rect :if={bucket.reposts > 0} x={x} y={218 - (bucket.likes + bucket.reposts) * scale} width={width} height={bucket.reposts * scale} fill="#06b6d4" /><rect :if={bucket.replies > 0} x={x} y={218 - bucket.total * scale} width={width} height={bucket.replies * scale} fill="#f59e0b" /></g>
        <g :if={@analytics.unit == "hour"} :for={{bucket, index} <- Enum.with_index(chart_buckets)} data-chart-tick><% x = 36 + (index + 0.5) * plot_width / length(chart_buckets) %><line x1={x} x2={x} y1="218" y2="224" stroke="currentColor" class="text-slate-400 dark:text-slate-500" /><text data-chart-hour-label={chart_tick_label(bucket.at, @analytics.unit)} x={x} y="244" text-anchor="middle" class="fill-slate-500 text-[9px]">{chart_tick_label(bucket.at, @analytics.unit)}</text></g>
        <g :if={@analytics.unit != "hour"} :for={index <- chart_tick_indices(length(chart_buckets))} data-chart-tick><% bucket = Enum.at(chart_buckets, index) %><% x = 36 + (index + 0.5) * plot_width / length(chart_buckets) %><line x1={x} x2={x} y1="218" y2="224" stroke="currentColor" class="text-slate-400 dark:text-slate-500" /><text x={x} y="244" text-anchor={chart_tick_anchor(index, length(chart_buckets))} class="fill-slate-500 text-[10px]">{chart_tick_label(bucket.at, @analytics.unit)}</text></g>
      </svg></div>
      <div class="mt-5 rounded-xl bg-brand-50 p-4 dark:bg-brand-950/40"><p class="text-sm font-semibold text-brand-900 dark:text-brand-100">{gettext("Busiest interval")}: {chart_peak.total} {gettext("interactions")}</p><p class="mt-1 text-sm text-brand-800 dark:text-brand-200">{bucket_label(chart_peak.at, @analytics.unit)}</p></div>
    </div>
  </section>
</div>
