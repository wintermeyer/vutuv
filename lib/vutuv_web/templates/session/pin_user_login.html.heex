<.auth_layout
  title={gettext("Please check your INBOX.")}
  subtitle={gettext("An email has been sent with your PIN. Once you enter your PIN below, you'll be logged in for the next 90 days on this device, or until you log out.")}
>
  <%!-- "Enter your PIN" alone can be read as an instruction to invent one, and
        somebody who skims this page sees little else. The heading now says
        where the PIN comes from, and the placeholder says what it looks like,
        so the two lines answer different questions instead of repeating one. --%>
  <h2 class="text-xl font-bold text-slate-900 dark:text-white">
    {gettext("Enter the PIN from the email")}
  </h2>

  <.form :let={f} for={%{}} action={~p"/login"} as={:session} class="mt-5 space-y-4" id="pin-form" method="post">
    <%= text_input f, :pin, class: input_class(), autofocus: true, autocomplete: "one-time-code", inputmode: "numeric", placeholder: gettext("6-digit PIN") %>
    <.button type="submit" class="w-full">{gettext("submit")}</.button>
  </.form>

  <%!-- Issue #912: shown only to members who set up an authenticator app or a
        one-time code list (see SessionHTML.alternative_codes?/1). --%>
  <p :if={alternative_codes?(@conn)} id="alternative-codes-hint" class="mt-2 text-sm text-slate-600 dark:text-slate-400">
    {gettext(
      "A one-time code (OTP) from your authenticator app or your code list also works here, instead of the emailed PIN."
    )}
  </p>

  <.pin_actions email={@pending_email} context={@pin_flow} />

  <.dev_mailbox_link />
</.auth_layout>
