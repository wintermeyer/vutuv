<.email_layout preheader="Conferma il tuo account vutuv" locale={@locale}>
  <.email_p>{email_greeting(@user)},</.email_p>
  <.email_p>grazie per l'iscrizione a vutuv. Ecco il PIN che ti serve per accedere:</.email_p>
  <.email_pin pin={@pin} />
  <.email_p>
    Il PIN scade dopo 30 minuti. Puoi sempre richiederne uno nuovo tornando su vutuv e accedendo di nuovo.
  </.email_p>
  <.email_p>Se il nostro servizio ti piace, parlane pure ai tuoi contatti.</.email_p>
  <.email_signature locale={@locale} />
</.email_layout>
