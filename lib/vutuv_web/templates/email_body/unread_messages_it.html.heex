<.email_layout preheader="Ha un nuovo messaggio su vutuv" locale={@locale}>
  <.email_p>{email_greeting(@user)},</.email_p>
  <.email_p>ha un nuovo messaggio da {@other_label} su vutuv:</.email_p>
  <.email_markdown :if={@message_body} body={@message_body} />
  <.email_button href={"#{@url}messages/#{@conversation_id}"}>Legga e risponda</.email_button>
  <.email_p>
    {(@each_message? &&
      "Riceverà un'e-mail come questa per ogni nuovo messaggio non letto.") ||
      "Per non riempirLe la casella di posta, questa è l'unica e-mail che riceverà su questa conversazione finché non la aprirà."} Decide Lei se scriverLe per ogni messaggio o solo per il primo, e quanto aspettiamo prima di inviare, nelle Sue <.email_link href={@settings_url}>impostazioni delle notifiche</.email_link>.
  </.email_p>
  <.email_signature locale={@locale} />
  <.email_unsubscribe_note locale={@locale} unsubscribe_url={@unsubscribe_url} />
</.email_layout>
