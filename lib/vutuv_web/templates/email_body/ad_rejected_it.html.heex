<.email_layout preheader="La tua pubblicità non andrà online" locale={@locale}>
  <.email_p>{email_greeting(@user)},</.email_p>
  <.email_p>
    purtroppo non possiamo pubblicare la tua pubblicità per il {@day}:
  </.email_p>
  <.email_panel>
    <.email_row label="Titolo">{@ad.title}</.email_row>
    <.email_row label="Testo">{@ad.body}</.email_row>
    <.email_row label="Link">{@ad.url}</.email_row>
  </.email_panel>
  <.email_p>
    La nostra motivazione: {@ad.rejection_reason}
  </.email_p>
  <.email_p>
    La prenotazione è quindi annullata, non paghi nulla e il giorno è di nuovo libero. Puoi prenotare una nuova pubblicità qui:
  </.email_p>
  <.email_button href={"#{@url}system/ads/new"}>Prenota una nuova pubblicità</.email_button>
  <.email_signature locale={@locale} />
</.email_layout>
