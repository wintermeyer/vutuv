<.email_layout preheader="Ihre Anzeige ist storniert" locale={@locale}>
  <.email_p>{email_greeting(@user)},</.email_p>
  <.email_p>
    wir haben Ihre Anzeige für den {@day} storniert:
  </.email_p>
  <.email_panel>
    <.email_row label="Titel">{@ad.title}</.email_row>
    <.email_row label="Text">{@ad.body}</.email_row>
    <.email_row label="Link">{@ad.url}</.email_row>
  </.email_panel>
  <.email_p>
    Sie läuft an diesem Tag nicht, und der Tag ist wieder frei. Eine bereits gestellte Rechnung schreiben wir Ihnen gut.
  </.email_p>
  <.email_button href={"#{@url}system/ads/bookings"}>Zu Ihren Buchungen</.email_button>
  <.email_signature locale={@locale} />
</.email_layout>
