<.email_layout preheader="Stornierung einer Anzeigenbuchung" locale={@locale}>
  <.email_heading>Stornierung einer Anzeigenbuchung</.email_heading>
  <.email_panel>
    <.email_row label="Tage">{@period}<span :if={@days > 1}> ({@days} Tage)</span></.email_row>
    <.email_row label="Preis">{@price} EUR (netto)</.email_row>
    <.email_row label="MwSt.">{@vat_percent} % → {@gross} EUR brutto</.email_row>
    <.email_row label="Storniert von">
      @{@booker.username} ({@url}{@booker.username})
    </.email_row>
  </.email_panel>
  <.email_p>
    Die Buchung wurde storniert, bevor die Anzeige freigeschaltet war. Der Zeitraum ist wieder frei.
  </.email_p>
  <.email_panel>
    <.email_row label="Titel">{@ad.title}</.email_row>
    <.email_row label="Text">{@ad.body}</.email_row>
    <.email_row label="Link">{@ad.url}</.email_row>
  </.email_panel>
  <.email_p><strong>Rechnungsadresse</strong></.email_p>
  <.email_p>
    <span :for={line <- String.split(@billing_address, "\n")}>{line}<br /></span>
  </.email_p>
  <.email_p>Falls die Rechnung schon verschickt ist, bitte gutschreiben.</.email_p>
</.email_layout>
