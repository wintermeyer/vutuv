<.email_layout preheader="Conferma l'eliminazione del tuo account" locale={@locale}>
  <.email_p>{email_greeting(@user)},</.email_p>
  <.email_p>per eliminare il tuo account inserisci il seguente PIN:</.email_p>
  <.email_pin pin={@pin} />
  <.email_p>
    <strong>ATTENZIONE:</strong> da questo passo non si torna indietro. Il tuo account verrà
    eliminato non appena inserirai questo PIN su vutuv. Il PIN scade dopo 30 minuti.
  </.email_p>
  <.email_p>Naturalmente puoi sempre creare un nuovo account.</.email_p>
  <.email_signature locale={@locale} />
</.email_layout>
