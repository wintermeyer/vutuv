<.email_layout preheader="File d'attente de modération" locale={@locale}>
  <.email_p>{email_greeting(@user)},</.email_p>
  <.email_p>
    {@open_count} dossier(s) de modération en attente d'une décision d'un administrateur.
  </.email_p>
  <.email_p>La file d'attente :</.email_p>
  <.email_button href={"#{@url}admin/moderation"}>Ouvrir la file d'attente</.email_button>
  <.email_signature locale={@locale} />
</.email_layout>
