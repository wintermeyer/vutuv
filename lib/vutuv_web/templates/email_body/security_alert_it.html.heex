<.email_layout preheader="Nuovo accesso al tuo account vutuv" locale={@locale}>
  <.email_p>{email_greeting(@user)},</.email_p>
  <.email_p>
    è stato appena effettuato un accesso al tuo account vutuv. Se l'accesso è tuo, puoi ignorare questa e-mail.
  </.email_p>
  <.email_panel>
    <.email_row label="Quando">{@when_text}</.email_row>
    <.email_row label="Dispositivo">{@device}</.email_row>
    <.email_row :if={@location} label="Luogo">{@location}</.email_row>
    <.email_row :if={@ip} label="IP">{@ip}</.email_row>
  </.email_panel>
  <.email_p>Perché te lo diciamo:</.email_p>
  <.email_list items={@reason_lines} />
  <.email_p>
    Se non riconosci questo accesso, controlla i dispositivi connessi al tuo account e disconnetti
    quelli che non riconosci:
  </.email_p>
  <.email_button href={@devices_url}>Controlla i dispositivi connessi</.email_button>
  <.email_signature locale={@locale} />
</.email_layout>
