<%!-- The owner's editor for this section — the user-agnostic /settings URL
(whoever opens it edits their own data). The public twin at /:slug/publications
shows the plain showcase view. Publications sort by date, so there is no
reorder tool here (like the other CV sections). --%>
<.settings_shell user={@user} active={:publications} title={gettext("Publications")}>
  <.card_section
    empty={Enum.empty?(@publications)}
    add_href={~p"/settings/publications/new"}
    add_label={gettext("Add a publication")}
  >
    <%= render "card_list.html", assigns %>
  </.card_section>

  <%!-- "Import from ORCID" (issue #2383): offered once the member lists an
  ORCID iD; before that, one line saying where the iD goes. Nothing on an
  installation with the import switched off. --%>
  <.card :if={@orcid_import == :available} class="mt-6" id="orcid-import-offer">
    <.section_title>{gettext("Import from ORCID")}</.section_title>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
      {gettext(
        "Your public ORCID record already lists your works. Read them in and pick the ones that belong here; nothing you have is overwritten."
      )}
    </p>
    <div class="mt-3">
      <.button href={~p"/settings/publications/orcid"}>{gettext("Read my ORCID record")}</.button>
    </div>
  </.card>

  <p
    :if={@orcid_import == :no_account}
    id="orcid-import-hint"
    class="mt-6 text-sm text-slate-600 dark:text-slate-400"
  >
    {gettext("Researchers: list your ORCID iD under your profiles and your works can be imported from your record.")}
    <.link
      navigate={~p"/settings/social_media_accounts/new"}
      class="font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300"
    >
      {gettext("Add your ORCID iD")}
    </.link>
  </p>
</.settings_shell>
