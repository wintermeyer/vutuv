<.form_page
  user={@user}
  active={:publications}
  section={{gettext("Publications"), ~p"/settings/publications"}}
  title={gettext("Edit publication")}
>
  <%= render "form_content.html", backlink: ~p"/settings/publications", changeset: @changeset, action: ~p"/settings/publications/#{@publication}", delete_to: ~p"/settings/publications/#{@publication}" %>
</.form_page>
