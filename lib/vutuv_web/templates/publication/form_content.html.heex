<.form :let={f} for={@changeset} action={@action} class="editform">
  <.form_error changeset={@changeset} />

  <.editform_field form={f} field={:title}>
    <%= label f, :title, gettext("Title") %>
    <%= text_input f, :title, [autofocus: true] ++ err_attrs(f, :title) %>
    <%= error_tag f, :title %>
  </.editform_field>

  <.editform_field form={f} field={:authors}>
    <%= label f, :authors do %>
      {gettext("Authors")}
      <span class="editform__optional">{gettext("(optional)")}</span>
    <% end %>
    <%= text_input f, :authors, err_attrs(f, :authors) %>
    <span class="editform__hint">
      {gettext("All authors as they appear on the paper, e.g. Müller, A., Schmidt, B.")}
    </span>
    <%= error_tag f, :authors %>
  </.editform_field>

  <.editform_field form={f} field={:publisher}>
    <%= label f, :publisher do %>
      {gettext("Published in")}
      <span class="editform__optional">{gettext("(optional)")}</span>
    <% end %>
    <%= text_input f, :publisher, err_attrs(f, :publisher) %>
    <span class="editform__hint">
      {gettext("The journal, conference, book or publisher, e.g. Nature 612")}
    </span>
    <%= error_tag f, :publisher %>
  </.editform_field>

  <%!-- One date, so month and year share a row. Two stacked full-width
        selects read as two unrelated questions. --%>
  <fieldset class="editform__group">
    <legend>{gettext("Published")}</legend>
    <div class="editform__row">
      <.editform_field form={f} field={:published_month}>
        <%= label f, :published_month, gettext("Month") %>
        <%= select f, :published_month, month_options(), [prompt: gettext("Month")] ++ err_attrs(f, :published_month) %>
        <%= error_tag f, :published_month %>
      </.editform_field>

      <.editform_field form={f} field={:published_year}>
        <%= label f, :published_year, gettext("Year") %>
        <%= select f, :published_year, year_options(), [prompt: gettext("Year")] ++ err_attrs(f, :published_year) %>
        <%= error_tag f, :published_year %>
      </.editform_field>
    </div>
  </fieldset>

  <.editform_field form={f} field={:url}>
    <%= label f, :url do %>
      {gettext("Link")}
      <span class="editform__optional">{gettext("(optional)")}</span>
    <% end %>
    <%= text_input f, :url, [placeholder: "https://"] ++ err_attrs(f, :url) %>
    <p :if={!f.errors[:url]} class="editform__hint">
      {gettext("The address of the paper, or just its DOI, e.g. 10.1000/xyz123")}
    </p>
    <%= error_tag f, :url %>
  </.editform_field>

  <.editform_field form={f} field={:description}>
    <%= label f, :description do %>
      {gettext("Description")}
      <span class="editform__optional">{gettext("(optional)")}</span>
    <% end %>
    <%= textarea f, :description, [rows: 3] ++ err_attrs(f, :description) %>
    <p class="editform__hint">
      {gettext("Markdown is supported: bold, italics, links and lists.")}
      <.markdown_help_link />
    </p>
    <%= error_tag f, :description %>
  </.editform_field>

  <%!-- The author's "tell my followers" choice (issue #980). Only the new-entry
        form passes :followers, so an edit never re-announces an old entry. --%>
  <.announce_to_followers_field :if={assigns[:followers]} form={f} followers={@followers} />

  <.form_actions backlink={@backlink} delete_to={assigns[:delete_to]} />
</.form>
