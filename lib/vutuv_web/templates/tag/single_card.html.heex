<% assigns = update_assigns(assigns) %>
<%!-- Nothing to say about this topic, no card. `description` is an admin-only
field (`/admin/tags/:slug`), so on the overwhelming majority of tag pages the
old empty state told the reader about a gap only somebody else can close — at
the very top of the page, above the posts they came for. --%>
<section :if={tag_front_matter?(assigns)} class="card" data-tag-front-matter>
	<%= if @tag_description do %>
	<h2 class="card__label"><%= gettext("Description") %></h2>
  <p><%= @tag_description %></p>
	<% end %>
  <%!-- The other names this topic answers to (issue #1338), so a reader who
  arrived by one of them knows where they ended up. --%>
  <div :if={@tag_aliases != []} data-tag-aliases>
    <h2 class="card__label">{gettext("Also known as")}</h2>
    <p>{alias_names(@tag_aliases)}</p>
  </div>
	<%= if Enum.count(@related_users) > 0 do %>
		<h2 class="card__label"><%= gettext("People you may know with this tag") %></h2>
		{VutuvWeb.UserHTML.card_list(Map.put(assigns, :users, @related_users))}
	<% end %>
	<%= if Enum.count(@recommended_users) > 0 do %>
		<h2 class="card__label"><%= gettext("The most endorsed users with this tag") %></h2>
		{VutuvWeb.UserHTML.card_list(Map.put(assigns, :users, @recommended_users))}
	<% end %>
</section>
