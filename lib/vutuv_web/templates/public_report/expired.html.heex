<div class="mx-auto max-w-xl py-6">
  <.card>
    <h1 class="text-xl font-bold text-slate-900 dark:text-white">
      {gettext("This link has expired")}
    </h1>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
      {gettext(
        "A confirmation link is good for one week. Yours has run out, so your report never reached our admins and nothing about the reported content changed."
      )}
    </p>
    <p class="mt-4">
      <.link
        href={~p"/system/report"}
        class="font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300"
      >
        {gettext("Send the report again")}
      </.link>
    </p>
  </.card>
</div>
