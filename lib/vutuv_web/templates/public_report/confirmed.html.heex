<div class="mx-auto max-w-xl py-6">
  <.card>
    <h1 class="text-xl font-bold text-slate-900 dark:text-white">
      {gettext("Thank you - your report is with our admins")}
    </h1>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
      {gettext(
        "A person will look at it. If the content was hidden by your report, it stays hidden until they have decided."
      )}
    </p>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
      {gettext("You do not need to do anything else.")}
    </p>
  </.card>
</div>
