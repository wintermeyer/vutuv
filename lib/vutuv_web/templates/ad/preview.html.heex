<.page_header crumbs={[
  {gettext("Advertising"), ~p"/system/ads"},
  gettext("Preview")
]} />

<div class="card-list">
  <section class="card">
    <h1>{gettext("Preview your ad")}</h1>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
      {gettext(
        "This is exactly how your ad will appear on profiles and in the feed on %{day}.",
        day: @ad.day
      )}
    </p>

    <%!-- The live card's ✕ and countdown have no business on the page that
    sells it, so this is the preview frame. --%>
    <VutuvWeb.AdComponents.ad_preview id="ad-preview" banner={{:ad, @ad}} class="mt-4" />

    <dl class="mt-6 grid gap-4 rounded-xl bg-slate-50 p-4 text-sm sm:grid-cols-3 dark:bg-slate-800/60">
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
          {gettext("Day")}
        </dt>
        <dd class="mt-1 font-bold text-slate-900 dark:text-slate-100">{@ad.day}</dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
          {gettext("Price")}
        </dt>
        <dd class="mt-1 font-bold text-slate-900 dark:text-slate-100">
          {VutuvWeb.AgentDocs.AdsDoc.price_display()}
        </dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
          {gettext("Billing address")}
        </dt>
        <dd class="mt-1 whitespace-pre-line text-slate-700 dark:text-slate-300">{[
          @ad.billing_name,
          @ad.billing_company,
          @ad.billing_street,
          "#{@ad.billing_zip_code} #{@ad.billing_city}",
          @ad.billing_country,
          @ad.vat_id
        ]
        |> Enum.reject(&(&1 in [nil, ""]))
        |> Enum.join("\n")}</dd>
      </div>
    </dl>

    <p class="mt-4 text-xs text-slate-600 dark:text-slate-400">
      {gettext(
        "Booking is binding; payment by invoice. We review and approve every ad before it runs."
      )}
    </p>

    <%!-- One form, two ways out: the default action books (binding), the
    second submit posts the same values back to the form for editing. --%>
    <form action={~p"/system/ads"} method="post" class="mt-4" id="ad-confirm-form">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input
        :for={{key, value} <- @ad_params}
        type="hidden"
        name={"ad[#{key}]"}
        value={value}
      />
      <div class="flex flex-wrap items-center gap-3">
        <.button type="submit" variant="secondary" formaction={~p"/system/ads/new"}>
          {gettext("Edit the ad")}
        </.button>
        <.button type="submit">
          {gettext("Book now (binding, by invoice)")}
        </.button>
      </div>
    </form>
  </section>
</div>
