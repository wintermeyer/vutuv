<.page_header
  title={gettext("My ad bookings")}
  crumbs={[
    {gettext("Advertising"), ~p"/system/ads"},
    gettext("My bookings")
  ]}
/>

<div class="card-list">
  <section class="card">
    <%= if @ads == [] do %>
      <p class="card__empty">{gettext("You have not booked an ad yet.")}</p>
      <div class="mt-4">
        <.button href={~p"/system/ads/new"}>{gettext("Book your ad")}</.button>
      </div>
    <% else %>
      <div class="divide-y divide-slate-100 dark:divide-slate-800">
        <div :for={ad <- @ads} id={"booking-#{ad.id}"} class="py-4 first:pt-0 last:pb-0">
          <div class="flex flex-wrap items-center gap-3">
            <span class="text-lg font-bold text-slate-900 dark:text-slate-100">
              {VutuvWeb.AdHTML.day_label(ad.day)}
            </span>
            <VutuvWeb.AdHTML.status_badge ad={ad} />
            <span class="ml-auto text-sm text-slate-600 dark:text-slate-400">
              {VutuvWeb.AgentDocs.AdsDoc.price_display(ad.price_cents)}
            </span>
          </div>
          <VutuvWeb.AdHTML.ad_outcome ad={ad} />
          <VutuvWeb.AdComponents.ad_preview id={"booking-#{ad.id}-ad"} banner={{:ad, ad}} class="mt-3" />
          <VutuvWeb.AdHTML.booking_actions ad={ad} />
        </div>
      </div>
      <div class="mt-6">
        <.button href={~p"/system/ads/new"} variant="secondary">{gettext("Book another day")}</.button>
      </div>
    <% end %>
  </section>
</div>
