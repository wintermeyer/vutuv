<.page_header
  title={gettext("Ad for %{day}", day: VutuvWeb.AdHTML.day_label(@ad.day))}
  crumbs={[
    {gettext("Admin"), ~p"/admin"},
    {gettext("Ads"), ~p"/admin/ads"},
    VutuvWeb.AdHTML.day_label(@ad.day)
  ]}
/>

<div class="card-list">
  <section class="card">
    <div class="flex flex-wrap items-center gap-3">
      <span class="text-lg font-bold text-slate-900 dark:text-slate-100">
        {VutuvWeb.AdHTML.day_label(@ad.day)}
      </span>
      <VutuvWeb.AdHTML.status_badge ad={@ad} />
    </div>

    <p
      :for={
        {label, at, by} <- [
          {gettext("Approved on"), @ad.approved_at, @ad.approved_by},
          {gettext("Rejected on"), @ad.rejected_at, @ad.rejected_by},
          {gettext("Cancelled on"), @ad.cancelled_at, @ad.cancelled_by}
        ]
      }
      :if={at}
      class="mt-1 text-sm text-slate-600 dark:text-slate-400"
    >
      {label}
      <.local_time at={at} />
      <%= if by do %>
        {gettext("by")}
        <.link
          href={~p"/#{by}"}
          class="font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300"
        >
          @{by.username}
        </.link>
      <% end %>
    </p>

    <.ad_details ad={@ad} />
    <.ad_review ad={@ad} />
  </section>
</div>
