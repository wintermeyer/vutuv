<.page_header
  title={gettext("Ad review")}
  crumbs={[
    {gettext("Admin"), ~p"/admin"},
    gettext("Ads")
  ]}
/>

<div class="card-list">
  <section class="card">
    <h1>{gettext("Upcoming ads")} ({compact_count(length(@upcoming_ads))})</h1>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
      {gettext(
        "Every ad must be approved before it runs. Check that it is family-friendly (community guidelines) before approving."
      )}
    </p>

    <p :if={@upcoming_ads == []} class="card__empty">
      {gettext("No upcoming ads.")}
    </p>

    <div
      :for={ad <- @upcoming_ads}
      id={"ad-#{ad.id}"}
      class="mt-4 rounded-xl p-4 ring-1 ring-slate-200 dark:ring-slate-800"
    >
      <div class="flex flex-wrap items-center gap-3">
        <.link
          href={~p"/admin/ads/#{ad}"}
          class="text-lg font-bold text-slate-900 hover:text-brand-700 dark:hover:text-brand-300 dark:text-slate-100"
        >
          {VutuvWeb.AdHTML.day_label(ad.day)}
        </.link>
        <VutuvWeb.AdHTML.status_badge ad={ad} />
        <.link
          href={~p"/admin/ads/#{ad}"}
          class="ml-auto text-sm font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300"
        >
          {gettext("Details")} ›
        </.link>
      </div>

      <.ad_details ad={ad} />
      <.ad_review ad={ad} />
    </div>
  </section>

  <section :if={@withdrawn_ads != []} class="card">
    <h1>{gettext("Rejected or cancelled")}</h1>
    <.ad_table id_prefix="withdrawn-ad" ads={@withdrawn_ads}>
      <:last :let={ad} label={gettext("Reason")}>{ad.rejection_reason}</:last>
    </.ad_table>
  </section>

  <section :if={@past_ads != []} class="card">
    <h1>{gettext("Past ads")}</h1>
    <.ad_table id_prefix="past-ad" ads={@past_ads}>
      <:last :let={ad} label={gettext("Billing name")}>{ad.billing_name}</:last>
    </.ad_table>
  </section>
</div>
