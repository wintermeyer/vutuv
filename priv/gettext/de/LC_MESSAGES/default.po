#, elixir-autogen, elixir-format
msgid "Repost floor"
msgstr "Mindestzahl Reposts"

#: lib/vutuv_web/templates/settings/auto_post_deletion.html.heex:246
#, elixir-autogen, elixir-format
msgid "Saving this rule deletes %{count} post straight away. It cannot be undone."
