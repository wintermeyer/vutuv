msgstr "Beiträge automatisch gelöscht"

#: lib/vutuv_web/templates/settings/auto_post_deletion.html.heex:113
#, elixir-autogen, elixir-format
msgid "Posts somebody answered"
msgstr "Beiträge, auf die jemand geantwortet hat"

#: lib/vutuv_web/templates/settings/auto_post_deletion.html.heex:106
