#: lib/vutuv_web/views/error_helpers.ex:113
#, elixir-autogen, elixir-format
msgid "PDF uploads are not available on this installation. Please upload an image instead."
msgstr "Les envois de PDF ne sont pas disponibles sur cette installation. Veuillez envoyer une image à la place."

#: lib/vutuv_web/views/error_helpers.ex:108
#, elixir-autogen, elixir-format
msgid "Please confirm that the file may be shown publicly. Without your consent nothing is uploaded."
msgstr "Veuillez confirmer que le fichier peut être affiché publiquement. Sans votre accord, rien n'est envoyé."

#: lib/vutuv_web/views/error_helpers.ex:117
#, elixir-autogen, elixir-format
msgid "could not be read. Please upload a PDF, JPG, PNG or WebP file."
msgstr "n'a pas pu être lu. Veuillez envoyer un fichier PDF, JPG, PNG ou WebP."

#: lib/vutuv_web/views/error_helpers.ex:112
#, elixir-autogen, elixir-format
msgid "is larger than 10 MB. Please upload a smaller file."
msgstr "dépasse 10 MB. Veuillez envoyer un fichier plus petit."

#: lib/vutuv_web/views/error_helpers.ex:131
#, elixir-autogen, elixir-format
msgid "must not be a web or email address"
msgstr "ne doit pas être une adresse web ou e-mail"

